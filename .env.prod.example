# Production settings for the VPS. On the server:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# then fill in the values. Never commit .env.prod.

# 50+ random characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=apps.zeneke.com

# Loopback port Caddy proxies to (reverse_proxy 127.0.0.1:<port>).
ZENEKE_PORT=8010

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: raise once HTTPS has been stable for a while (e.g. 31536000).
# SECURE_HSTS_SECONDS=3600
