# Local development values. Copy to src/.env (loaded automatically; real
# environment variables always take precedence over this file).
# Without DEBUG=true the app runs in production mode and needs a real
# SECRET_KEY and ALLOWED_HOSTS.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Production only (see src/README.md):
# Directory holding db.sqlite3; point it at a persistent volume.
# DATA_DIR=/data
# How long browsers remember "HTTPS only" for this site, in seconds.
# SECURE_HSTS_SECONDS=3600
# Normally derived from ALLOWED_HOSTS as https://<host>; set to override.
# CSRF_TRUSTED_ORIGINS=https://zeneke.example.com
